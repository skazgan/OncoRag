# Copy to .env and edit. All variables are optional; the defaults run fully offline.

# --- Embeddings ---------------------------------------------------------
# "hashing"              -> deterministic, offline, no downloads (tests / CI / quick demo)
# "sentence-transformers" -> real neural embeddings (pip install -e ".[ml]")
ONCORAG_EMBEDDING_BACKEND=hashing
ONCORAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Reranker -----------------------------------------------------------
# "none" | "lexical" (offline heuristic) | "cross-encoder" (pip install -e ".[ml]")
ONCORAG_RERANKER_BACKEND=lexical
ONCORAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Generation ---------------------------------------------------------
# "extractive" (offline, no LLM) | "anthropic" (pip install -e ".[llm]")
ONCORAG_LLM_BACKEND=extractive
ONCORAG_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- PubMed (NCBI E-utilities) -----------------------------------------
# NCBI asks for a contact email; an API key raises the rate limit from 3 to 10 req/s.
ONCORAG_NCBI_EMAIL=
ONCORAG_NCBI_API_KEY=

# --- Storage ------------------------------------------------------------
ONCORAG_INDEX_DIR=index_store
# Optional: use a Qdrant server instead of embedded local mode
# ONCORAG_QDRANT_URL=http://localhost:6333
